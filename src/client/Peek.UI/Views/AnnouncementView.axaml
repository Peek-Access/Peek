<UserControl
    x:Class="Peek.UI.Views.AnnouncementView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:Peek.Core.i18n"
    xmlns:models="using:Peek.Core.Models"
    xmlns:views="using:Peek.UI.Views"
    xmlns:vm="using:Peek.Core.ViewModels"
    x:DataType="{x:Type vm:AnnouncementViewModel}"
    AutomationProperties.LandmarkType="ContentInfo"
    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.ScreenReader_HistoryHeader}}">
    <UserControl.Styles>
        <Style Selector="Button.announcementAction">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Styles>
    <Border
        MinHeight="154"
        Padding="18,14"
        Background="{DynamicResource PipboySurfaceBrush}"
        BorderBrush="{DynamicResource PipboyBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource PipboyCornerRadiusPanel}"
        IsVisible="{Binding HistoryEnabled}">
        <Grid RowDefinitions="Auto,90,Auto,Auto" RowSpacing="10">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Panel Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource PipboySuccessBrush}" />
                    </Panel>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Translate {x:Static i18n:LanguageManager+Keys.ScreenReader_HistoryHeader}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button
                        Classes="announcementAction"
                        Command="{Binding CopyHistoryCommand}"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.ScreenReader_HistoryCopy}}" />
                    <Button
                        Classes="announcementAction"
                        Command="{Binding ClearHistoryCommand}"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.ScreenReader_HistoryClear}}" />
                    <Button
                        Classes="announcementAction"
                        Command="{Binding ReplaySelectedCommand}"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.ScreenReader_HistoryReplay}}"
                        IsEnabled="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.ScreenReader_HistoryReplayTooltip}}" />
                    <Button
                        Classes="announcementAction"
                        Command="{Binding ToggleExpandedCommand}"
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.ScreenReader_HistoryExpandCollapse}}">
                        <!--  Viewbox, not Width/Height on the Path - see MainWindow.axaml's
                              minimize button for why a non-square icon needs this to actually
                              center.  -->
                        <Viewbox Width="16" Height="16" Stretch="Uniform">
                            <Path Classes="icon" Data="{StaticResource Icon.ChevronDown}" Fill="{DynamicResource PipboyTextDimBrush}" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <views:AnnouncementWave
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                Height="90"
                IsSpeaking="{Binding IsSpeaking}"
                AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.ScreenReader_SpeechActivity}}" />

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock
                    Grid.Column="0"
                    FontSize="12"
                    Foreground="{DynamicResource PipboyTextDimBrush}"
                    Text="{Binding LatestAnnouncement}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    FontSize="11"
                    Foreground="{DynamicResource PipboyTextDimBrush}"
                    Text="{Translate {x:Static i18n:LanguageManager+Keys.ScreenReader_VoiceLabel}}"
                    VerticalAlignment="Center" />
            </Grid>

            <Border
                Grid.Row="3"
                Padding="6"
                Background="{DynamicResource PipboyBackgroundBrush}"
                BorderBrush="{DynamicResource PipboyBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource PipboyCornerRadiusControl}"
                IsVisible="{Binding IsExpanded}"
                MaxHeight="160"
                MinHeight="110">
                <!--
                    Double-click or Enter replays the same as the toolbar's Replay button (see
                    AnnouncementView.axaml.cs) - the same "explicit button plus row shortcuts"
                    pattern AppMonitorView/ProcessMonitorView already use for their own
                    double-click-to-act rows.
                -->
                <ListBox
                    Name="HistoryList"
                    Background="Transparent"
                    BorderThickness="0"
                    DoubleTapped="OnHistoryRowDoubleTapped"
                    ItemsSource="{Binding History.Entries}"
                    KeyDown="OnHistoryListKeyDown"
                    SelectedItem="{Binding SelectedEntry}"
                    SelectionMode="Single">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem" x:DataType="models:AnnouncementEntry">
                            <Setter Property="Padding" Value="4,3" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:AnnouncementEntry}">
                            <StackPanel ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.ScreenReader_HistoryReplayTooltip}}">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{DynamicResource PipboyTextDimBrush}"
                                    Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                                <TextBlock
                                    FontSize="12"
                                    Text="{Binding Text}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Border>
</UserControl>
