<UserControl
    x:Class="Peek.UI.Views.DockAnnouncementView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:Peek.Core.i18n"
    xmlns:views="using:Peek.UI.Views"
    xmlns:vm="using:Peek.Core.ViewModels"
    x:DataType="{x:Type vm:AnnouncementViewModel}">
    <UserControl.Styles>
        <Style Selector="Button.announcementAction">
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Styles>
    <Border
        Margin="8,0,8,8"
        MinHeight="154"
        Padding="12"
        Background="{DynamicResource PipboySurfaceBrush}"
        BorderBrush="{DynamicResource PipboyBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource PipboyCornerRadiusPanel}"
        IsVisible="{Binding HistoryEnabled}">
        <Grid RowDefinitions="Auto,82,Auto,Auto" RowSpacing="8">
            <StackPanel Grid.Row="0" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Panel Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource PipboySuccessBrush}" />
                    </Panel>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Translate {x:Static i18n:LanguageManager+Keys.ScreenReader_HistoryHeader}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button
                        Classes="announcementAction"
                        Command="{Binding CopyHistoryCommand}"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.ScreenReader_HistoryCopy}}" />
                    <Button
                        Classes="announcementAction"
                        Command="{Binding ClearHistoryCommand}"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.ScreenReader_HistoryClear}}" />
                    <Button
                        Classes="announcementAction"
                        Command="{Binding ToggleExpandedCommand}"
                        AutomationProperties.Name="Expand or collapse announcement history">
                        <TextBlock FontSize="16" Text="⌄" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <views:AnnouncementWave
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                Height="82"
                IsSpeaking="{Binding IsSpeaking}"
                AutomationProperties.Name="Speech activity" />

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock
                    Grid.Column="0"
                    FontSize="12"
                    Foreground="{DynamicResource PipboyTextDimBrush}"
                    Text="{Binding LatestAnnouncement}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    FontSize="11"
                    Foreground="{DynamicResource PipboyTextDimBrush}"
                    Text="Peek · Voice"
                    VerticalAlignment="Center" />
            </Grid>

            <Border
                Grid.Row="3"
                Padding="10"
                Background="{DynamicResource PipboyBackgroundBrush}"
                BorderBrush="{DynamicResource PipboyBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource PipboyCornerRadiusControl}"
                IsVisible="{Binding IsExpanded}"
                MaxHeight="160"
                MinHeight="110">
                <ScrollViewer>
                    <TextBlock
                        FontSize="12"
                        Text="{Binding History.Transcript}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
