<Window
    ExtendClientAreaToDecorationsHint="True"
    Height="620"
    Icon="avares://Peek.UI/Assets/peek-icon.ico"
    Title="{Translate {x:Static i18n:LanguageManager+Keys.ElementDetail_WindowTitle}}"
    Width="480"
    WindowDecorations="BorderOnly"
    WindowStartupLocation="CenterOwner"
    d:DesignHeight="620"
    d:DesignWidth="480"
    mc:Ignorable="d"
    x:Class="Peek.UI.Views.ElementDetailWindow"
    x:DataType="{x:Type automation:SemanticElement}"
    xmlns="https://github.com/avaloniaui"
    xmlns:automation="using:Peek.Worker.Contracts.Automation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i18n="using:Peek.Core.i18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Peek.UI.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="*, 40">
        <ScrollViewer>
            <views:ElementDetailView Margin="16" />
        </ScrollViewer>
        <Button
            Click="Button_OnClick"
            Content="{Translate {x:Static i18n:LanguageManager+Keys.About_Close}}"
            Grid.Row="1"
            Margin="5" />
    </Grid>
</Window>
