<Window
    x:Class="Peek.Views.MainWindow"
    x:Name="Self"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i18n="using:Peek.Core.i18n"
    xmlns:uiviews="using:Peek.UI.Views"
    xmlns:views="using:Peek.Views"
    xmlns:vm="using:Peek.Core.ViewModels"
    Title="Peek"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="{x:Type vm:MainViewModel}"
    ExtendClientAreaTitleBarHeightHint="34"
    ExtendClientAreaToDecorationsHint="True"
    Icon="avares://Peek.UI/Assets/peek-icon.ico"
    mc:Ignorable="d">
    <Window.Styles>
        <!--  Flat, borderless title-bar buttons (About). Icon color lives here rather than on
              a Foreground the Path could inherit - Path is a Shape (Fill/Stroke), not a
              TextElement, so it doesn't inherit Foreground from its parent Button the way the
              old glyph TextBlocks did; these descendant selectors are the replacement.  -->
        <Style Selector="Button.titleBarIconBtn">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource PipboyCornerRadiusControl}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.titleBarIconBtn Path.icon">
            <Setter Property="Fill" Value="{DynamicResource PipboyTextDimBrush}" />
        </Style>
        <Style Selector="Button.titleBarIconBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource PipboyHoverBrush}" />
        </Style>
        <Style Selector="Button.titleBarIconBtn:pointerover Path.icon">
            <Setter Property="Fill" Value="{DynamicResource PipboyTextBrush}" />
        </Style>
        <!--  Same flat chrome as the About button, plus a checked state for the pin toggle.  -->
        <Style Selector="ToggleButton.titleBarIconBtn">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource PipboyCornerRadiusControl}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.titleBarIconBtn Path.icon">
            <Setter Property="Fill" Value="{DynamicResource PipboyTextDimBrush}" />
        </Style>
        <Style Selector="ToggleButton.titleBarIconBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource PipboyHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.titleBarIconBtn:pointerover Path.icon">
            <Setter Property="Fill" Value="{DynamicResource PipboyTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.titleBarIconBtn:checked Path.icon">
            <Setter Property="Fill" Value="{DynamicResource PipboyPrimaryLightBrush}" />
        </Style>
        <!--  Hollow-flag/filled-flag pin icon - same shape family as every other icon in
              Resources/Icons.axaml, so the pinned state is visible by shape as well as by the
              checked-state color above.  -->
        <Style Selector="Path.pinGlyph">
            <Setter Property="Data" Value="{StaticResource Icon.Pin}" />
        </Style>
        <Style Selector="ToggleButton.titleBarIconBtn:checked Path.pinGlyph">
            <Setter Property="Data" Value="{StaticResource Icon.PinFilled}" />
        </Style>
    </Window.Styles>
    <Grid
        x:Name="WindowLayout"
        RowDefinitions="34,*">

        <!--
            Left side deliberately left empty: with a real Icon/Title set (see below),
            Windows already draws the icon + "Peek" text natively in that space even
            with the client area extended - an app-drawn duplicate there overlapped it.
        -->
        <Grid
            Name="TitleBarButtons"
            Grid.Row="0"
            Margin="10,0,10,0"
            ColumnDefinitions="*,Auto"
            WindowDecorationProperties.ElementRole="User">

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">

                <!--
                    Not needed in docked mode: WindowsEdgeDockingService already forces the
                    window HWND_TOPMOST at the Win32 level whenever it repositions it (see
                    ApplyPosition), independent of this Topmost binding - toggling it off
                    while docked would have no visible effect. Hidden there in code-behind
                    (ConfigureShell), the same place NormalShellView/DockedShellView switch.
                -->
                <ToggleButton
                    Name="PinButton"
                    Classes="titleBarIconBtn"
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.MainWindow_Pin}}"
                    Click="OnPinClick"
                    IsChecked="{Binding #Self.Topmost, Mode=TwoWay}"
                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.MainWindow_Pin}}">
                    <!--
                        No literal Data swap here - the ":checked" style above drives both the
                        geometry and the fill, so the pinned/unpinned states pick up theme
                        colors (PipboyTextDimBrush / PipboyPrimaryLightBrush) the same way
                        every other title-bar icon does.
                    -->
                    <Path Classes="icon pinGlyph" Width="13" Height="13" />
                </ToggleButton>

                <Button
                    Classes="titleBarIconBtn"
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Dock_About}}"
                    Click="OnAboutClick"
                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Dock_About}}">
                    <Path Classes="icon" Width="13" Height="13" Data="{StaticResource Icon.Info}" />
                </Button>

                <!--  Native min/max/close are gone now that both shells use BorderOnly (see
                      ApplyShellChrome) - these replace them.  -->
                <Button
                    Classes="titleBarIconBtn"
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.MainWindow_Minimize}}"
                    Click="OnMinimizeClick"
                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.MainWindow_Minimize}}">
                    <!--
                        Viewbox, not Width/Height directly on the Path: Icon.Minimize's own
                        bounding box (a thin 12x2 bar) is nowhere near square, and a Path
                        forced into a square render box via its own Stretch="Uniform" does NOT
                        center the leftover space evenly the way Viewbox does - confirmed by
                        actually running the app: the bar rendered hugging the top of its box
                        instead of sitting mid-height like every other title-bar icon. Viewbox
                        is the reliable way to both scale-to-fit AND center.
                    -->
                    <Viewbox Width="13" Height="13" Stretch="Uniform">
                        <Path Classes="icon" Data="{StaticResource Icon.Minimize}" />
                    </Viewbox>
                </Button>

                <!--  Two separate buttons, not one toggle whose name/tooltip changes with
                      state: AutomationProperties.Name only has ever been set as a plain
                      attribute elsewhere in this app, so that's what a screen reader is known
                      to pick up here too - see MainWindow.axaml.cs for which one is IsVisible.  -->
                <Button
                    Name="MaximizeButton"
                    Classes="titleBarIconBtn"
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.MainWindow_Maximize}}"
                    Click="OnMaximizeRestoreClick"
                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.MainWindow_Maximize}}">
                    <Path Classes="icon" Width="13" Height="13" Data="{StaticResource Icon.Maximize}" />
                </Button>
                <Button
                    Name="RestoreButton"
                    Classes="titleBarIconBtn"
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.MainWindow_Restore}}"
                    Click="OnMaximizeRestoreClick"
                    IsVisible="False"
                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.MainWindow_Restore}}">
                    <Path Classes="icon" Width="13" Height="13" Data="{StaticResource Icon.Restore}" />
                </Button>

                <Button
                    Classes="titleBarIconBtn"
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.MainWindow_Close}}"
                    Click="OnCloseClick"
                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.MainWindow_Close}}">
                    <Path Classes="icon" Width="13" Height="13" Data="{StaticResource Icon.Close}" />
                </Button>
            </StackPanel>
        </Grid>

        <!--
            Both declared statically (not swapped in via code-behind Content assignment) so
            their regions - "MainRegion" / "DockRegion" plus each shell's announcement region,
            see DockShellViewModel - are
            registered the moment MainWindow.InitializeComponent() runs, before either
            MainViewModel or DockShellViewModel is even constructed (see
            MainWindow.axaml.cs/App.axaml.cs) - constructing them lazily raced the eager
            navigation each ViewModel's constructor kicks off against its region existing
            yet ("Region not found or has been collected").
        -->
        <views:MainView
            x:Name="NormalShellView"
            Grid.Row="1"
            IsVisible="False" />
        <uiviews:DockShellView
            x:Name="DockedShellView"
            Grid.Row="1"
            IsVisible="False" />

    </Grid>
</Window>
