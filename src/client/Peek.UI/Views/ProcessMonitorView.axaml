<UserControl
    x:Class="Peek.UI.Views.ProcessMonitorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Peek.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i18n="using:Peek.Core.i18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Peek.Core.ViewModels"
    d:DesignHeight="680"
    d:DesignWidth="1000"
    x:DataType="{x:Type vm:ProcessMonitorViewModel}"
    AutomationProperties.LandmarkType="Main"
    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Nav_ProcessMonitor}}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:MemorySizeConverter x:Key="MemorySizeConverter" />
    </UserControl.Resources>
    <Grid Margin="18,16" RowDefinitions="Auto,Auto,*" RowSpacing="14">

        <StackPanel
            Grid.Row="0"
            Margin="4,4,4,0"
            Spacing="5">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="{Translate {x:Static i18n:LanguageManager+Keys.Nav_ProcessMonitor}}" />
            <TextBlock
                FontSize="13"
                Foreground="{DynamicResource PipboyTextDimBrush}"
                Text="{Translate {x:Static i18n:LanguageManager+Keys.ProcessMonitor_HelpText}}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  WrapPanel, not a horizontal StackPanel: at a docked strip's narrow width this
              toolbar has too many controls to fit on one line - a StackPanel would let them
              overflow past the page instead of wrapping.  -->
        <Border
            Grid.Row="1"
            Padding="14,12"
            Background="{DynamicResource PipboySurfaceBrush}"
            BorderBrush="{DynamicResource PipboyBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource PipboyCornerRadiusPanel}">
            <WrapPanel Orientation="Horizontal">
            <Button
                Margin="0,0,10,4"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.ProcessMonitor_RefreshTooltip}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Width="11" Height="11" VerticalAlignment="Center" Data="{StaticResource Icon.Refresh}" Fill="{DynamicResource PipboyTextDimBrush}" />
                    <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Common_Refresh}}" />
                </StackPanel>
            </Button>
            <Button
                Margin="0,0,10,4"
                Command="{Binding KillCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Width="11" Height="11" VerticalAlignment="Center" Data="{StaticResource Icon.Close}" Fill="{DynamicResource PipboyTextDimBrush}" />
                    <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.ProcessMonitor_EndProcessButton}}" />
                </StackPanel>
            </Button>
            <Button
                Margin="0,0,10,4"
                Command="{Binding OpenFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Width="12" Height="12" VerticalAlignment="Center" Data="{StaticResource Icon.Folder}" Fill="{DynamicResource PipboyTextDimBrush}" />
                    <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.ProcessMonitor_OpenFolderButton}}" />
                </StackPanel>
            </Button>
            <CheckBox
                Margin="0,0,10,4"
                Content="{Translate {x:Static i18n:LanguageManager+Keys.ProcessMonitor_ShowSystemProcessesCheckbox}}"
                IsChecked="{Binding ShowSystemProcesses}" />
            <TextBlock
                Margin="0,0,0,4"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{DynamicResource PipboyTextDimBrush}"
                IsVisible="{Binding IsLoading}"
                Text="{Translate {x:Static i18n:LanguageManager+Keys.Common_Loading}}" />
            </WrapPanel>
        </Border>

        <!--  Pipboy.Avalonia.ProDataGrid's theme deliberately zeroes DataGridBorderThickness/
              DataGridBorderBrush (flat design) - it expects the DataGrid's outer border to
              come from a wrapping Border like this one, not from the control itself.  -->
        <Border
            Grid.Row="2"
            Padding="1"
            BorderBrush="{DynamicResource PipboyBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{DynamicResource PipboyCornerRadiusPanel}">
            <DataGrid
                Name="Grid"
                AutoGenerateColumns="False"
                CanUserReorderColumns="True"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding Processes}"
                RowHeight="30"
                SelectedItem="{Binding SelectedProcess}"
                SelectionMode="Single">

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding KillCommand}" Header="{Translate {x:Static i18n:LanguageManager+Keys.ProcessMonitor_EndProcessMenu}}" />
                        <MenuItem Command="{Binding OpenFolderCommand}" Header="{Translate {x:Static i18n:LanguageManager+Keys.ProcessMonitor_OpenFolderMenu}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="2*"
                        Binding="{Binding Name}"
                        Header="{Translate {x:Static i18n:LanguageManager+Keys.ProcessMonitor_ProcessName}}" />
                    <DataGridTextColumn
                        Width="0.7*"
                        Binding="{Binding Id}"
                        Header="PID" />
                    <DataGridTextColumn
                        Width="1*"
                        Binding="{Binding MemoryBytes, Converter={StaticResource MemorySizeConverter}}"
                        Header="{Translate {x:Static i18n:LanguageManager+Keys.ProcessMonitor_Memory}}" />
                    <DataGridTextColumn
                        Width="2.5*"
                        Binding="{Binding Description}"
                        Header="{Translate {x:Static i18n:LanguageManager+Keys.Field_Description}}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
