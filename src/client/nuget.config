<?xml version="1.0" encoding="utf-8"?>
<!--
  Only declares the pipboy-preview SOURCE (name and URL), no credentials, since this
  file is checked into source control. CI (.github/workflows/build_binary.yml)
  separately runs "dotnet nuget add source" (with no config file argument, so it
  targets the runner's machine-level NuGet config, not this file) to attach
  credentials to a source of the same name. NuGet resolves a source's credentials
  by matching its name across every config file in the hierarchy - this file's own
  clear element only clears which source entries apply here, not where credentials
  may come from - so the two files are not actually in conflict, just split across
  two locations for the reason above. Locally, outside CI, restoring pipboy-preview
  packages needs those same credentials added once via "dotnet nuget add source"
  yourself; see Pipboy.Avalonia's own README for the token this expects.
-->
<configuration>
  <packageSources>
    <clear />

    <add key="nuget.org"
         value="https://api.nuget.org/v3/index.json" />

    <add key="pipboy-preview"
         value="https://nuget.pkg.github.com/NeverMorewd/index.json" />

  </packageSources>
</configuration>
